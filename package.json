{
  "name": "willfire",
  "version": "0.1.0",
  "description": "Predict the set of CI check entries GitHub Actions will create for a pull request",
  "license": "MIT",
  "author": "Kevin Scott <me@thekevinscott.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekevinscott/willfire.git"
  },
  "keywords": [
    "github-actions",
    "ci",
    "workflow",
    "pull-request",
    "prediction"
  ],
  "type": "module",
  "main": "dist/predict.js",
  "types": "dist/predict.d.ts",
  "exports": {
    ".": {
      "types": "./dist/predict.d.ts",
      "default": "./dist/predict.js"
    }
  },
  "bin": {
    "willfire": "dist/predict.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "predict": "tsx src/predict.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "testing-conventions": "^0.0.91",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
