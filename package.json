{
  "name": "willfire",
  "version": "0.1.0",
  "description": "Predict the set of CI check entries GitHub Actions will create for a pull request",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "author": "Kevin Scott <me@thekevinscott.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekevinscott/willfire.git"
  },
  "keywords": [
    "github-actions",
    "ci",
    "workflow",
    "pull-request",
    "prediction"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "willfire": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "predict": "tsx src/cli.ts",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "tsx tests/e2e/verify.ts"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "testing-conventions": "^0.0.91",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  }
}
